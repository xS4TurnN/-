-- ФУНКЦИЯ СОЗДАНИЯ ТУМБЛЕРОВ
-- ============================
local function CreateToggle(parent, name, yPos, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 360, 0, 35)
    Btn.Position = UDim2.new(0, 20, 0, yPos)
    Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Btn.BorderSizePixel = 1
    Btn.BorderColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Text = name .. ": ВЫКЛ"
    Btn.Font = Enum.Font.Gotham
    Btn.TextSize = 14
    Btn.Parent = parent

    local active = false
    Btn.MouseButton1Click:Connect(function()
        active = not active
        Btn.Text = name .. (active and ": ВКЛ" or ": ВЫКЛ")
        Btn.BackgroundColor3 = active and Color3.fromRGB(0, 100, 0) or Color3.fromRGB(20, 20, 20)
        callback(active)
    end)
    return Btn
end

