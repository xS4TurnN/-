-- Флай
local FlyVel = nil
local function UpdateFly()
    if not LocalPlayer.Character then return end
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if Settings.Fly then
        if not FlyVel then
            FlyVel = Instance.new("BodyVelocity")
            FlyVel.MaxForce = Vector3.new(100000, 100000, 100000)
            FlyVel.Velocity = Vector3.new(0, 0, 0)
            FlyVel.Parent = hrp
        end
        local move = Vector3.new(0, 0, 0)
        local cam = workspace.CurrentCamera
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0, 1, 0) end
        FlyVel.Velocity = move * Settings.FlySpeed
    else
        if FlyVel then FlyVel:Destroy(); FlyVel = nil end
    end
end

-- Главный цикл
RunService.RenderStepped:Connect(function()
    -- Aimbot (через Camera)
    if Settings.Aimbot and LocalPlayer.Character then
        local target = nil
        for _, obj in pairs(workspace:GetChildren()) do
            if obj ~= LocalPlayer.Character and obj:IsA("Model") then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen and math.abs(sp.X - FOVCircle.AbsolutePosition.X - 45) < 45 and math.abs(sp.Y - FOVCircle.AbsolutePosition.Y - 45) < 45 then
                        target = hrp
                        break
                    end
                end
            end
        end
        if target then
            -- Меняем CFrame камеры, а не персонажа (безопаснее)
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        end
    end

    -- ESP
    for _, v in pairs(ESPFolder:GetChildren()) do v:Destroy() end
    if Settings.EspMonsters or Settings.EspPlayers or Settings.EspWeapons then
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil
                    if (Settings.EspMonsters and not isPlayer) or (Settings.EspPlayers and isPlayer) then
                        local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                        if onScreen then
                            local Box = Instance.new("Frame", ESPFolder)
                            Box.Size = UDim2.new(0, 50, 0, 70)
                            Box.Position = UDim2.new(0, sp.X - 25, 0, sp.Y - 50)
                            Box.BackgroundTransparency = 1
                            Box.BorderSizePixel = 2
                            Box.BorderColor3 = Color3.fromRGB(255, 255, 255)
                        end
                    end
                end
            end
            if Settings.EspWeapons and obj:IsA("Tool") then
                local handle = obj:FindFirstChild("Handle")
                if handle then
                    local sp, onScreen = Camera:WorldToViewportPoint(handle.Position)
                    if onScreen then
                        local Label = Instance.new("TextLabel", ESPFolder)
                        Label.Text = obj.Name
                        Label.Size = UDim2.new(0, 100, 0, 20)
                        Label.Position = UDim2.new(0, sp.X - 50, 0, sp.Y - 20)
                        Label.BackgroundTransparency = 1
                        Label.TextColor3 = Color3.fromRGB(255, 255, 255)
                    end
                end
            end
        end
    end

    -- Speed (через RenderStepped, но с постоянным обновлением)
    if Settings.Speed and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = Settings.SpeedValue
        end
    end

    UpdateFly()
end)
